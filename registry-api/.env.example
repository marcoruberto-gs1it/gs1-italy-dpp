# Porta locale (in produzione non serve: Docker la fissa a 4310, vedi docker-compose.yml)
PORT=4310

# Postgres per i dati delle schede DPP (stesso progetto Supabase di mock-eu-registry, tabella
# separata gs1_dpp_records — creata da sola al primo avvio). Vedi docs/REGISTRY-SETUP.md.
REGISTRY_DATABASE_URL=

# Password della sezione admin — vuota = accesso libero (comodo in sviluppo, MAI in produzione).
REGISTRY_ADMIN_PASSWORD=
# Segreto per firmare il cookie di sessione — senza, le sessioni non sopravvivono a un riavvio.
REGISTRY_AUTH_SECRET=

# Webshop pubblico: dove vivono le PAGINE (/01/{gtin}, /product-info/{gtin}). Sono le destinazioni
# a cui il resolver reindirizza e il liveURL/backupURL che mock-eu-registry scarica per l'hash,
# quindi deve essere raggiungibile dal cloud. Vuota = webshop di produzione (mai localhost).
SITE_URL=

# Resolver GS1 pubblico: origine dell'IDENTIFICATORE Digital Link ({resolver}/01/{gtin}), usata per
# @id/UPI del JSON-LD, UPI del registro UE e anchor del linkset. Vuota = resolver di produzione.
RESOLVER_PUBLIC_URL=

# --- Registro UE (mock-eu-registry) — vedi docs/REGISTRY-SETUP.md per come ottenerli ---
MOCK_EU_REGISTRY_URL=
AUTH0_DOMAIN=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_M2M_AUDIENCE=
