# Porta locale (in produzione non serve: Docker la fissa a 4310, vedi docker-compose.yml)
PORT=4310

# Percorso del file SQLite. In locale un file qualunque va bene; in Docker è fissato dal
# Dockerfile su /data/registry.sqlite (volume persistente).
REGISTRY_DB_PATH=./data/registry.sqlite

# Password della sezione admin — vuota = accesso libero (comodo in sviluppo, MAI in produzione).
REGISTRY_ADMIN_PASSWORD=
# Segreto per firmare il cookie di sessione — senza, le sessioni non sopravvivono a un riavvio.
REGISTRY_AUTH_SECRET=

# URL pubblico del sito, usato per costruire il link GS1 Digital Link (/01/{gtin}) registrato
# su mock-eu-registry come liveURL/backupURL.
SITE_URL=http://localhost:4200

# --- Registro UE (mock-eu-registry) — vedi docs/REGISTRY-SETUP.md per come ottenerli ---
MOCK_EU_REGISTRY_URL=
AUTH0_DOMAIN=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_M2M_AUDIENCE=
