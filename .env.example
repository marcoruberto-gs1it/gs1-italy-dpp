# Copiare in `.env` e compilare. In locale servono solo le variabili Gemini/Vertex:
# per il resto i default del compose bastano.

# ── Vertex AI / Gemini (business-agent) ──────────────────────────────────────
# Progetto GCP usato per billing e quota di Vertex AI. L'autenticazione avviene con il
# service account montato da secrets/gcp-sa.json (anch'esso fuori dal versionamento).
#
# Va valorizzata ANCHE se si avvia il solo webshop e l'assistente resta spento: compose
# interpola l'intero file prima di sapere quali servizi gli hai chiesto, e questa variabile
# è dichiarata obbligatoria (`:?`) nel business-agent. Senza, `up -d webshop` non parte:
#   error while interpolating services.business-agent.environment.GOOGLE_CLOUD_PROJECT
GOOGLE_CLOUD_PROJECT=<progetto-gcp>
GOOGLE_CLOUD_LOCATION=global
# Combinazione modello+region verificata contro i 429 RESOURCE_EXHAUSTED.
GEMINI_MODEL=gemini-3.5-flash

# Alternativa a Vertex: impostare GOOGLE_GENAI_USE_VERTEXAI=false nel compose e usare questa.
GOOGLE_API_KEY=<gemini api key>

# ── Accesso all'assistente AI ────────────────────────────────────────────────
# Password unica che protegge /assistente e /api. Vuota = nessuno sbarramento.
# Serve a non far consumare quota Vertex a chiunque passi, non a proteggere dati.
CHAT_PASSWORD=
# Segreto con cui si firma il cookie di sessione: senza, le sessioni cadono a ogni
# riavvio del container. Generane uno con: openssl rand -hex 32
CHAT_AUTH_SECRET=

# ── Produzione (usate solo con docker-compose.prod.yml) ──────────────────────
# Dominio puntato all'IP del droplet, senza schema. È l'apex: www redirige qui (il
# middleware è pronto ma commentato in docker-compose.prod.yml, vedi il commento lì).
WEBSHOP_HOST=catalogosmart.it

# URL pubblico completo: finisce in sitemap.xml, robots.txt, llms.txt, nei canonical delle
# pagine prerenderizzate e negli URL immagine del feed /catalog. È un build arg del
# webshop: cambiarlo richiede un `up -d --build`, non basta ricreare il container.
SITE_URL=https://catalogosmart.it

# ACME_EMAIL non serve qui: in produzione i certificati li gestisce lo stack `edge/` del
# branch main, che legge il .env di quella directory.

# Solo per l'ambiente locale, se la porta 80 è occupata (es. HTTP_PORT=8081).
# HTTP_PORT=80

# ── Reverse proxy: locale vs droplet ────────────────────────────────────────
# In locale questo stack è l'unico sulla macchina e si porta il suo Traefik, che però sta
# dietro un profilo (vedi docker-compose.yml): questa riga lo accende, e i comandi
# `docker compose up -d --build` restano quelli di sempre.
#
# Sul droplet la riga NON va messa: lì la porta 80 è condivisa con poc-lab.gs1it.dev e il
# reverse proxy è lo stack `edge/` del branch main, avviato una volta per tutte da quella
# directory con
#   docker compose -p edge --env-file .env -f edge/docker-compose.yml up -d
COMPOSE_PROFILES=edge
